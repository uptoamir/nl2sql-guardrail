# Copy to .env and fill in the values you need.
# Only OPENAI_API_KEY is strictly required for the default config; pass --mock to skip it.

# ─── LLM provider ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
NL2SQL_LLM_PROVIDER=openai            # openai | anthropic | mock
NL2SQL_LLM_MODEL=gpt-4o-mini-2024-07-18  # pinned exact version (P1-18 model-drift detection)
NL2SQL_LLM_TEMPERATURE=0.0            # determinism is what we want for SQL generation
NL2SQL_LLM_TIMEOUT_S=30
NL2SQL_LLM_MAX_RETRIES=2              # network-level retries (tenacity)

# ─── Agent behaviour ─────────────────────────────────────────────────────────
NL2SQL_AGENT_MAX_REPAIR_ATTEMPTS=3    # bounded Reflexion loop
NL2SQL_RESULT_ROW_LIMIT=100           # hard cap injected if LLM omits LIMIT
NL2SQL_QUERY_TIMEOUT_MS=5000          # threading.Timer wall-clock kill switch
NL2SQL_INPUT_TOKEN_BUDGET=8000        # tiktoken pre-call budget (BudgetExceeded)
NL2SQL_OUTPUT_TOKEN_BUDGET=1500

# ─── Database ────────────────────────────────────────────────────────────────
NL2SQL_DB_PATH=employees.db

# ─── Department selection ───────────────────────────────────────────────────
# Leave empty for production behaviour (random pick across Sales/Marketing/Engineering).
# Setting this is for demos / tests ONLY — every override is logged loudly.
NL2SQL_DEPARTMENT_OVERRIDE=
NL2SQL_RANDOM_SEED=                   # set to an int to make the random pick reproducible

# ─── Logging + audit ─────────────────────────────────────────────────────────
NL2SQL_LOG_LEVEL=INFO                 # DEBUG / INFO / WARNING / ERROR
NL2SQL_AUDIT_LOG_PATH=logs/audit.jsonl  # one JSON object per turn

# ─── Observability — OTel → Phoenix (local dev only) ─────────────────────────
# Bring up Phoenix via:  docker compose --profile obs up
# Production uses ADOT collector DaemonSet auto-configured via Helm values.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=nl2sql-local
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# ─── Cache (v0 defaults) ─────────────────────────────────────────────────────
NL2SQL_SEMANTIC_CACHE_ENABLED=false   # v0 defaults off; enable when chromadb container is up
NL2SQL_SEMANTIC_CACHE_TTL_S=3600
NL2SQL_CHROMADB_HOST=localhost
NL2SQL_CHROMADB_PORT=8000
