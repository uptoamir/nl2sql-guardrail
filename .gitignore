# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Virtual envs
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# Editor / OS
.idea/
.vscode/
.DS_Store
*.swp
*~

# Secrets
.env
.env.local
.env.*.local

# Runtime artefacts
logs/
*.log
audit.jsonl

# uv / pip
.uv/
pip-wheel-metadata/

# Markdown — only README.md ships at the repo root; all other root-level
# .md files are local drafts / implementation notes / audit logs / plans /
# spec docs and stay un-tracked. The negation rule (!src/**/*.md) preserves
# the prompt templates inside the package, which ARE part of the build.
*.md
!README.md
!src/**/*.md
